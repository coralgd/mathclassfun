rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function role() {
      return isAuth() ? userDoc(request.auth.uid).role : null;
    }

    function isElder() {
      return role() == "elder";
    }

    function isModer() {
      return role() == "moder" || role() == "elder";
    }

    match /users/{uid} {
      allow read: if isAuth();

      allow create: if isAuth()
                    && request.auth.uid == uid
                    && request.resource.data.role == "player"
                    && request.resource.data.verificationStatus == "none"
                    && request.resource.data.blocked == false;

      allow update: if isAuth()
                    && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.verificationStatus == resource.data.verificationStatus
                    && request.resource.data.blocked == resource.data.blocked
                    && request.resource.data.deviceFingerprint == resource.data.deviceFingerprint;

      allow delete: if false;
    }

    match /votes/{voteId} {
      allow read: if isAuth();

      allow create: if isAuth()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == "pending";

      allow update: if (isAuth()
                      && resource.data.uid == request.auth.uid
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.status == "withdrawn")
                    || isModer();

      allow delete: if false;
    }

    match /verificationRequests/{uid} {
      allow create: if isAuth()
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.status == "pending";
      allow read, update: if isModer();
      allow delete: if false;
    }

    match /leaderboardResults/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /blockedDevices/{fingerprint} {
      allow read, write: if isElder();
    }

    match /activityLogs/{id} {
      allow read: if isModer();
      allow write: if false;
    }
  }
}
